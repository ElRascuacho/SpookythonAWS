{
  "name": "operacion-manta-cero",
  "private": true,
  "version": "1.0.0",
  "description": "Operación Zero Day — Simulación Epidemiológica 3D SEIR-V en Grafo Urbano (Spookython AWS Track B)",
  "type": "module",
  "scripts": {
    "invite": "bun scripts/create-invite.ts",
    "invite:cloud": "bun scripts/issue-cloud-invite.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lambda": "bun build backend/handler.ts --target=node --format=esm --outfile=build/lambda/handler.mjs && bun build backend/workerHandler.ts --target=node --format=esm --outfile=build/lambda/workerHandler.mjs",
    "preview": "vite preview",
    "test": "bun test",
    "ingest": "bun scripts/ingest-fixtures.ts",
    "openapi": "bun scripts/generate-openapi.ts",
    "admin": "bun scripts/admin-invitations.ts",
    "verify:cloud": "bun scripts/verify-cloud.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1157.0",
    "@aws-sdk/client-dynamodb": "^3.1157.0",
    "@aws-sdk/client-lambda": "^3.1158.0",
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/lib-dynamodb": "^3.1157.0",
    "@tailwindcss/vite": "^4.1.0",
    "driver.js": "1.10.2",
    "lucide-react": "^0.475.0",
    "maplibre-gl": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
